# ---------------------------------------------------------------------------
# ClauseGuard backend configuration
# Copy to .env and fill in real values. NEVER commit the .env file.
# ---------------------------------------------------------------------------

# Runtime -------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Port the HTTP server binds to.
PORT=4000
# debug | info | warn | error | silent
LOG_LEVEL=info

# Database ------------------------------------------------------------------
# MongoDB connection string. Required.
MONGODB_URI=mongodb://127.0.0.1:27017/clauseguard

# Authentication ------------------------------------------------------------
# Required. Minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Token lifetime, e.g. 15m, 12h, 7d.
JWT_EXPIRES_IN=7d
# bcrypt cost factor (8-15). Higher is slower and more secure.
BCRYPT_SALT_ROUNDS=12

# Password reset email (production requires HTTPS frontend URL and valid Resend sender)
FRONTEND_URL=http://localhost:5173
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=ClauseGuard <notifications@example.com>

# AI provider ---------------------------------------------------------------
# Currently supported: gemini | groq
AI_PROVIDER=gemini
# Required for Gemini contract analysis. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# Required for Groq contract analysis. Get one at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
# Abort an AI request after this many milliseconds.
AI_REQUEST_TIMEOUT_MS=60000
# Contract text beyond this many characters is truncated before analysis.
AI_MAX_INPUT_CHARS=120000

# File uploads --------------------------------------------------------------
# Directory for stored contract PDFs (relative paths resolve from the project root).
UPLOAD_DIR=uploads
# Maximum upload size in bytes. Default 10 MB.
MAX_FILE_SIZE=10485760

# CORS ----------------------------------------------------------------------
# Local Vite frontend; production requires explicit HTTPS origins (no wildcard).
CORS_ORIGIN=http://localhost:5173

# Rate limiting -------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Background scheduler ------------------------------------------------------
SCHEDULER_ENABLED=true
# Cron expression for the reminder dispatcher (default: every minute).
REMINDER_CRON=* * * * *
# Cron expression for the overdue-obligation sweep (default: hourly).
OVERDUE_CRON=0 * * * *
# All scheduling and stored dates are UTC.
SCHEDULER_TIMEZONE=UTC
REMINDER_BATCH_SIZE=50
REMINDER_MAX_ATTEMPTS=3

# Tests ---------------------------------------------------------------------
# Optional. When set, the database-backed integration suite runs against it.
# Use a DISPOSABLE database - the suite clears collections between tests.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/clauseguard-test
