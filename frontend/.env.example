# ---------------------------------------------------------------------------
# ClauseGuard frontend configuration
# Copy to .env.local to override. Both are optional for local development:
# the Vite dev server proxies /api to http://localhost:4000 by default
# (see vite.config.ts), matching the ClauseGuard backend's default port.
# ---------------------------------------------------------------------------

# Only needed if the backend is NOT on http://localhost:4000, or in a
# production build where there is no dev-server proxy (point this at the
# deployed backend's real /api base URL instead).
# VITE_API_BASE_URL=http://localhost:4000/api
